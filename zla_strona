from flask import Flask, render_template, request
import os

app = Flask(__name__)
UPLOAD_FOLDER = 'uploads'
os.makedirs(UPLOAD_FOLDER, exist_ok=True)

@app.route('/')
def index():
    # Używamy tego samego wyglądu, żeby pokazać, że "pod spodem" jest różnica
    return render_template('index.html') 

@app.route('/upload', methods=['POST'])
def upload():
    file = request.files.get('file')
    
    # 🚨 BRAK SPRAWDZANIA ROZSZERZEŃ (Wchodzi wszystko: .exe, .php, .txt)
    # 🚨 BRAK SECURE_FILENAME (Haker może podać nazwę ../../wirus.exe)
    # 🚨 BRAK UUID (Nowy plik nadpisze stary, jeśli mają tę samą nazwę)
    
    filename = file.filename
    file.save(os.path.join(UPLOAD_FOLDER, filename))
    
    return "<h1>Plik wyslany! (Ale wcale nie bezpiecznie 😈)</h1><a href='/'>Wroc</a>"

if __name__ == '__main__':
    # Odpalamy na porcie 5001, żeby nie gryzło się z Twoją dobrą stroną!
    app.run(debug=True, port=5001)
